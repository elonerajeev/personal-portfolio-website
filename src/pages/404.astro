---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found | Rajeev Kumar" noindex>
  <section class="mx-auto flex max-w-xl flex-col items-center px-4 py-32 text-center">
    <p class="font-mono text-xs tracking-widest text-accent uppercase">404 Not Found</p>
    <h1 class="mt-3 text-3xl font-semibold">This page doesn't exist.</h1>
    <p class="mt-3 font-mono text-sm text-muted">$ kubectl get page → Error: not found</p>
    <a href="/" class="mt-8 rounded-md border border-border px-4 py-2 text-sm hover:border-accent">
      Back to home
    </a>
  </section>
</BaseLayout>
