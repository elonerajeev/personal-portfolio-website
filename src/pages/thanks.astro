---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Message sent | Rajeev Kumar" noindex>
  <section class="mx-auto flex max-w-xl flex-col items-center px-4 py-32 text-center">
    <p class="font-mono text-xs tracking-widest text-accent uppercase">200 OK</p>
    <h1 class="mt-3 text-3xl font-semibold">Thanks, your message was sent.</h1>
    <p class="mt-3 text-muted">I'll get back to you within a couple of days.</p>
    <a href="/" class="mt-8 rounded-md border border-border px-4 py-2 text-sm hover:border-accent">
      Back to home
    </a>
  </section>
</BaseLayout>
