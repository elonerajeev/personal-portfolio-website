---
import { Icon } from 'astro-icon/components';
import ThemeToggle from './ThemeToggle.astro';
import { nav, site } from '../data/site';
---

<header class="sticky top-0 z-40 border-b border-border/60 bg-bg/80 backdrop-blur supports-[backdrop-filter]:bg-bg/60">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4 sm:px-6">
    <a href="/" class="flex items-center gap-1.5 font-mono text-sm font-semibold tracking-tight">
      <Icon name="logo" class="size-5 text-accent" aria-hidden="true" />
      {site.shortName}
    </a>

    <nav aria-label="Primary" class="hidden md:block">
      <ul class="flex items-center gap-1 text-sm">
        {nav.map((item) => (
          <li>
            <a
              href={`/${item.href}`}
              class="rounded-md px-3 py-2 text-muted transition-colors hover:text-fg"
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={site.resume}
        class="hidden items-center gap-1.5 rounded-md border border-border px-3 py-1.5 text-sm transition-colors hover:border-accent hover:text-accent sm:inline-flex"
      >
        <Icon name="lucide:file-text" class="size-4" aria-hidden="true" />
        Resume
      </a>
      <ThemeToggle />
      <details class="group relative md:hidden" data-mobile-nav>
        <summary
          class="flex size-9 cursor-pointer list-none items-center justify-center rounded-md border border-border [&::-webkit-details-marker]:hidden"
          aria-label="Toggle menu"
        >
          <Icon name="lucide:menu" class="size-5 group-open:hidden" aria-hidden="true" />
          <Icon name="lucide:x" class="hidden size-5 group-open:block" aria-hidden="true" />
        </summary>
        <nav
          aria-label="Mobile"
          class="absolute right-0 mt-2 w-56 rounded-lg border border-border bg-surface p-2 shadow-xl"
        >
          <ul class="flex flex-col text-sm">
            {nav.map((item) => (
              <li>
                <a href={`/${item.href}`} class="block rounded-md px-3 py-2 hover:bg-surface-2">
                  {item.label}
                </a>
              </li>
            ))}
            <li>
              <a
                href={site.resume}
                class="block rounded-md px-3 py-2 text-accent hover:bg-surface-2"
              >
                Resume (PDF)
              </a>
            </li>
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  // Close the mobile menu after a link is chosen.
  for (const menu of document.querySelectorAll<HTMLDetailsElement>('[data-mobile-nav]')) {
    menu.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) menu.open = false;
    });
  }
</script>
