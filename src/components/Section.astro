---
interface Props {
  id: string;
  eyebrow: string;
  title: string;
  intro?: string;
}

const { id, eyebrow, title, intro } = Astro.props;
---

<section
  id={id}
  class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-24"
  aria-labelledby={`${id}-title`}
>
  <p class="font-mono text-xs tracking-widest text-accent uppercase">{eyebrow}</p>
  <h2
    id={`${id}-title`}
    class="mt-2 text-3xl font-semibold tracking-tight text-balance sm:text-4xl"
  >
    {title}
  </h2>
  {intro && <p class="mt-4 max-w-2xl text-pretty text-muted">{intro}</p>}
  <div class="mt-12">
    <slot />
  </div>
</section>
