---
import { Icon } from 'astro-icon/components';
---

<button
  type="button"
  data-theme-toggle
  class="flex size-9 items-center justify-center rounded-md border border-border text-muted transition-colors hover:text-fg"
  aria-label="Toggle colour theme"
>
  <Icon name="lucide:sun" class="hidden size-4 dark:block" aria-hidden="true" />
  <Icon name="lucide:moon" class="size-4 dark:hidden" aria-hidden="true" />
</button>

<script>
  for (const button of document.querySelectorAll('[data-theme-toggle]')) {
    button.addEventListener('click', () => {
      const root = document.documentElement;
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch {
        /* storage unavailable */
      }
    });
  }
</script>
